[Unit]
Description=PiPedal GPIO button controller
After=sound.target pipedald.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 -u /home/pi/controller.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
